specVersion: 0.0.5
schema:
  file: ./schema.graphql
dataSources:
  - kind: ethereum
    name: FounderNFT
    network: localhost
    source:
      address: '0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9'
      abi: FounderNFT
      startBlock: 0
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.7
      language: wasm/assemblyscript
      entities:
        - User
        - FounderNFT
        - StakeEvent
        - RewardClaim
        - PlatformStats
        - RewardRate
      abis:
        - name: FounderNFT
          file: ./abis/FounderNFT.json
      eventHandlers:
        - event: FounderNFTMinted(indexed address,indexed uint256)
          handler: handleFounderNFTMinted
        - event: TokenStaked(indexed address,indexed uint256)
          handler: handleTokenStaked
        - event: TokenUnstaked(indexed address,indexed uint256)
          handler: handleTokenUnstaked
        - event: RewardClaimed(indexed address,indexed uint256,uint256)
          handler: handleRewardClaimed
        - event: RewardAdded(uint256,uint256)
          handler: handleRewardAdded
        - event: RewardRateUpdated(uint256,uint256)
          handler: handleRewardRateUpdated
        - event: ETHReceived(indexed address,uint256)
          handler: handleETHReceived
      file: ./src/founder-nft.ts
