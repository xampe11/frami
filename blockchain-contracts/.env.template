# =============================================================================
# PHASE 1 DEPLOYMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# =============================================================================
# DEPLOYMENT CREDENTIALS
# =============================================================================

# Private key for deployment (without 0x prefix)
# SECURITY: Never share this key or commit it to version control
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Treasury address to receive platform fees (optional, defaults to deployer)
# For production, consider using a multisig wallet
TREASURY_ADDRESS=0x1234567890123456789012345678901234567890

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# RPC URLs for different networks
# Get these from providers like Alchemy, Infura, or QuickNode

# Mainnet (Ethereum)
MAINNET_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/YOUR_API_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Sepolia Testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.alchemyapi.io/v2/YOUR_API_KEY
POLYGON_API_KEY=YOUR_POLYGONSCAN_API_KEY

# Arbitrum
ARBITRUM_RPC_URL=https://arb-mainnet.alchemyapi.io/v2/YOUR_API_KEY
ARBITRUM_API_KEY=YOUR_ARBISCAN_API_KEY

# Base
BASE_RPC_URL=https://base-mainnet.alchemyapi.io/v2/YOUR_API_KEY
BASE_API_KEY=YOUR_BASESCAN_API_KEY

# Local development
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# =============================================================================
# PLATFORM CONFIGURATION
# =============================================================================

# Platform fee percentage in basis points (500 = 5%)
# Maximum allowed: 1000 (10%)
PLATFORM_FEE_PERCENTAGE=500

# =============================================================================
# FOUNDER NFT CONFIGURATION
# =============================================================================

# Maximum number of NFTs that can be minted
# Recommended: 500-10000 depending on your community size
FOUNDER_NFT_MAX_SUPPLY=1000

# Price per NFT in wei (100000000000000000 = 0.1 ETH)
# Consider your target audience and market conditions
FOUNDER_NFT_PRICE=100000000000000000

# Percentage of platform fees distributed to NFT stakers (2500 = 25%)
# This should be attractive enough to incentivize staking
PLATFORM_FEE_DISTRIBUTION_PERCENTAGE=2500

# Percentage allocated for future DAO token allocation (1000 = 10%)
# Reserved for future governance token distribution
DAO_TOKEN_ALLOCATION_PERCENTAGE=1000

# Minimum staking period in seconds (604800 = 7 days)
# Prevents flash loan attacks and encourages long-term holding
MINIMUM_STAKING_PERIOD=604800

# Whether to activate sales immediately after deployment
# Set to false if you want to announce before opening sales
ACTIVATE_SALE_IMMEDIATELY=true

# =============================================================================
# DEPLOYMENT TRACKING (Auto-populated by deployment script)
# =============================================================================

# These will be filled automatically by the deployment script
# PLATFORM_REGISTRY_PROXY=
# PLATFORM_REGISTRY_IMPL=
# FOUNDER_NFT_PROXY=
# FOUNDER_NFT_IMPL=
# DEPLOYMENT_BLOCK=
# DEPLOYMENT_TIMESTAMP=
# CHAIN_ID=
# NETWORK_NAME=

# =============================================================================
# CONFIGURATION EXAMPLES BY NETWORK
# =============================================================================

# Example configurations for different deployment scenarios:

# MAINNET PRODUCTION EXAMPLE:
# FOUNDER_NFT_MAX_SUPPLY=1000
# FOUNDER_NFT_PRICE=100000000000000000  # 0.1 ETH
# PLATFORM_FEE_PERCENTAGE=500           # 5%
# MINIMUM_STAKING_PERIOD=604800         # 7 days
# TREASURY_ADDRESS=0x...multisig...     # Use multisig for security

# TESTNET TESTING EXAMPLE:
# FOUNDER_NFT_MAX_SUPPLY=100
# FOUNDER_NFT_PRICE=10000000000000000   # 0.01 ETH (lower for testing)
# PLATFORM_FEE_PERCENTAGE=500
# MINIMUM_STAKING_PERIOD=3600           # 1 hour (faster testing)
# TREASURY_ADDRESS=                     # Leave empty to use deployer

# POLYGON PRODUCTION EXAMPLE:
# FOUNDER_NFT_MAX_SUPPLY=2000
# FOUNDER_NFT_PRICE=50000000000000000000 # 50 MATIC
# PLATFORM_FEE_PERCENTAGE=500
# MINIMUM_STAKING_PERIOD=604800

# =============================================================================
# SECURITY NOTES
# =============================================================================

# 1. PRIVATE KEY SECURITY:
#    - Never share your private key
#    - Use a dedicated deployment wallet
#    - Consider using hardware wallets for production
#    - Rotate keys regularly

# 2. TREASURY SECURITY:
#    - Use a multisig wallet for production deployments
#    - Distribute multisig keys among trusted team members
#    - Set up proper governance procedures

# 3. CONFIGURATION VALIDATION:
#    - Test all configurations on testnet first
#    - Verify all parameters before mainnet deployment
#    - Have emergency procedures ready

# 4. RPC ENDPOINTS:
#    - Use reliable providers (Alchemy, Infura, QuickNode)
#    - Have backup RPC endpoints ready
#    - Monitor rate limits and usage

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================

# Before deployment:
# [ ] Set all required environment variables
# [ ] Verify network configuration
# [ ] Test on testnet first
# [ ] Ensure sufficient ETH for gas
# [ ] Backup all configuration

# After deployment:
# [ ] Verify contracts on block explorer
# [ ] Test all core functionality
# [ ] Set up monitoring
# [ ] Update frontend configuration
# [ ] Announce to community

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# Common Issues and Solutions:

# 1. "Insufficient funds for gas":
#    - Ensure deployer wallet has enough ETH
#    - Check current gas prices on the network
#    - Consider deploying during lower gas periods

# 2. "Invalid private key":
#    - Remove 0x prefix from private key
#    - Ensure key is 64 characters long
#    - Verify key corresponds to funded address

# 3. "RPC connection failed":
#    - Check RPC URL is correct and accessible
#    - Verify API key is valid and has quota
#    - Try alternative RPC provider

# 4. "Contract verification failed":
#    - Wait a few minutes after deployment
#    - Ensure compiler version matches
#    - Check constructor arguments are correct

# 5. "Transaction underpriced":
#    - Increase gas price in foundry.toml
#    - Wait for network congestion to reduce
#    - Use dynamic gas pricing

# For additional support:
# - Check Foundry documentation: https://book.getfoundry.sh/
# - Review deployment logs for specific errors
# - Test on local network first: anvil