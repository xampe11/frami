# ==================================================
# FounderNFT Deployment Environment Configuration
# ==================================================
# Copy this file to .env and update the values

# ===== REQUIRED VARIABLES =====
# Platform Registry address (must be deployed first)
PLATFORM_REGISTRY_ADDRESS=

# Deployer private key (keep this secure!)
DEPLOYER_PRIVATE_KEY=

# ===== OPTIONAL VARIABLES (with defaults) =====
# FounderNFT Configuration
FOUNDER_NFT_MAX_SUPPLY=1000
FOUNDER_NFT_PRICE=250000000000000000  # 0.25 ETH in wei
PLATFORM_FEE_DISTRIBUTION_PERCENTAGE=5000  # 50% (in basis points)
DAO_TOKEN_ALLOCATION_PERCENTAGE=1000        # 10% (in basis points)
MINIMUM_STAKING_PERIOD=604800              # 7 days in seconds
ACTIVATE_SALE_IMMEDIATELY=false

# ===== NETWORK CONFIGURATION =====
# RPC URLs for different networks
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY  

# ===== CONTRACT VERIFICATION =====
# Etherscan API keys for verification
ETHERSCAN_API_KEY=
# POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY
# ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY
# OPTIMISTIC_ETHERSCAN_API_KEY=YOUR_OPTIMISTIC_ETHERSCAN_API_KEY

# ===== UPGRADE CONFIGURATION =====
# For upgrades, set the existing proxy address
FOUNDER_NFT_PROXY_ADDRESS=

# Frontend directory path (default: ../frontend)
FRONTEND_DIR="../front-end/client"
# Output directory within frontend (default: src/contracts)
OUTPUT_DIR="src/contracts"


REPORT_GAS=true