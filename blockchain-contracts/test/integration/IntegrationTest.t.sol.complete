// SPDX-License-Identifier: MIT
pragma solidity 0.8.28;

import "forge-std/Test.sol";
import "forge-std/console.sol";
import {ERC1967Proxy} from "../../src/proxy/ERC1967Proxy.sol";
import {PlatformRegistry} from "../../src/PlatformRegistry.sol";
import {Project} from "../../src/Project.sol";
import {ProjectFactory} from "../../src/ProjectFactory.sol";
import {FounderNFT} from "../../src/FounderNFT.sol";

contract IntegrationTest is Test {
    // Proxies
    ERC1967Proxy public registryProxy;
    ERC1967Proxy public factoryProxy;
    ERC1967Proxy public founderNFTProxy;

    // Implementation contracts (wrapped proxies)
    PlatformRegistry public registry;
    ProjectFactory public factory;
    FounderNFT public founderNFT;

    // Implementation addresses
    address public registryImpl;
    address public factoryImpl;
    address public projectImpl;
    address public founderNFTImpl;

    // Dynamic extension keys
    bytes32 public constant FOUNDER_NFT_KEY = keccak256("FOUNDER_NFT");
    bytes32 public constant PROJECT_FACTORY_KEY = keccak256("PROJECT_FACTORY");
    bytes32 public constant ORACLE_KEY = keccak256("ORACLE");
    bytes32 public constant VALIDATOR_KEY = keccak256("VALIDATOR");
    bytes32 public constant NFT_FACTORY_KEY = keccak256("NFT_FACTORY");
    bytes32 public constant TOKEN_FACTORY_KEY = keccak256("TOKEN_FACTORY");

    // Extension categories
    bytes32 public constant CATEGORY_FACTORY = keccak256("FACTORY");
    bytes32 public constant CATEGORY_ORACLE = keccak256("ORACLE");
    bytes32 public constant CATEGORY_GOVERNANCE = keccak256("GOVERNANCE");
    bytes32 public constant CATEGORY_TREASURY = keccak256("TREASURY");
    bytes32 public constant CATEGORY_VALIDATOR = keccak256("VALIDATOR");
    bytes32 public constant CATEGORY_TOKEN = keccak256("TOKEN");
    bytes32 public constant CATEGORY_NFT = keccak256("NFT");
    bytes32 public constant CATEGORY_UTILITY = keccak256("UTILITY");

    // Constants for FounderNFT
    uint256 constant MAX_SUPPLY = 100;
    uint256 constant NFT_PRICE = 0.1 ether;
    uint256 constant FEE_DISTRIBUTION_PERCENTAGE = 5000; // 50%
    uint256 constant DAO_TOKEN_ALLOCATION = 1000; // 10%
    uint256 constant MIN_STAKING_PERIOD = 7 days;

    // Test accounts
    address public owner;
    address public treasury;
    address public verifier;
    address public creator;
    address public investor1;
    address public investor2;
    address public founder1;
    address public founder2;
    address public founder3;

    // Created project
    address public projectAddress;
    Project public project;

    function setUp() public {
        // Setup accounts
        owner = address(this);
        treasury = makeAddr("treasury");
        verifier = makeAddr("verifier");
        creator = makeAddr("creator");
        investor1 = makeAddr("investor1");
        investor2 = makeAddr("investor2");
        founder1 = makeAddr("founder1");
        founder2 = makeAddr("founder2");
        founder3 = makeAddr("founder3");

        // Fund accounts
        vm.deal(creator, 5 ether);
        vm.deal(investor1, 20 ether);
        vm.deal(investor2, 20 ether);
        vm.deal(founder1, 5 ether);
        vm.deal(founder2, 5 ether);
        vm.deal(founder3, 5 ether);

        // Set consistent starting time
        vm.warp(1);

        // Deploy implementations
        PlatformRegistry registryImplementation = new PlatformRegistry();
        registryImpl = address(registryImplementation);

        Project projectImplementation = new Project();
        projectImpl = address(projectImplementation);

        ProjectFactory factoryImplementation = new ProjectFactory();
        factoryImpl = address(factoryImplementation);

        FounderNFT founderNFTImplementation = new FounderNFT();
        founderNFTImpl = address(founderNFTImplementation);

        // Deploy PlatformRegistry proxy with dynamic system
        bytes memory registryData = abi.encodeWithSelector(
            PlatformRegistry.initialize.selector,
            owner,
            500, // 5% platform fee
            treasury
        );

        registryProxy = new ERC1967Proxy(registryImpl, registryData);
        registry = PlatformRegistry(payable(address(registryProxy)));

        // Deploy ProjectFactory proxy
        bytes memory factoryData =
            abi.encodeWithSelector(ProjectFactory.initialize.selector, owner, address(registryProxy), projectImpl);

        factoryProxy = new ERC1967Proxy(factoryImpl, factoryData);
        factory = ProjectFactory(address(factoryProxy));

        // Register ProjectFactory using dynamic extension system
        vm.prank(owner);
        registry.registerExtension(
            PROJECT_FACTORY_KEY,
            address(factoryProxy),
            CATEGORY_FACTORY,
            "Project Factory",
            "2.0.0",
            "Creates and manages crowdfunding projects",
            new bytes32[](0)
        );

        // Deploy FounderNFT proxy
        bytes memory founderNFTData = abi.encodeWithSelector(
            FounderNFT.initialize.selector,
            owner,
            address(registryProxy),
            MAX_SUPPLY,
            NFT_PRICE,
            FEE_DISTRIBUTION_PERCENTAGE,
            DAO_TOKEN_ALLOCATION,
            MIN_STAKING_PERIOD
        );

        founderNFTProxy = new ERC1967Proxy(founderNFTImpl, founderNFTData);
        founderNFT = FounderNFT(payable(address(founderNFTProxy)));

        // Register FounderNFT using dynamic extension system
        vm.prank(owner);
        registry.registerExtension(
            FOUNDER_NFT_KEY,
            address(founderNFTProxy),
            CATEGORY_NFT,
            "Founder NFT",
            "2.0.0",
            "Governance and rewards NFT for platform founders",
            new bytes32[](0)
        );

        // Enable sale for FounderNFT
        founderNFT.setSaleStatus(true);

        // Grant platform role to registry
        founderNFT.grantRole(founderNFT.PLATFORM_ROLE(), address(registryProxy));

        // Set up roles for factory
        vm.prank(owner);
        factory.grantRole(factory.ADMIN_ROLE(), address(registryProxy));

        // Verify initial setup using dynamic extension keys
        (uint256 founderPct, uint256 treasuryPct) = registry.getFeeDistribution();
        assertEq(founderPct, 5000, "Initial founder percentage should be 50%");
        assertEq(treasuryPct, 5000, "Initial treasury percentage should be 50%");
    }

    function testDynamicExtensionIntegration() public view {
        // Test that all extensions are properly registered
        assertEq(
            registry.getExtension(PROJECT_FACTORY_KEY),
            address(factoryProxy),
            "ProjectFactory should be registered with correct key"
        );

        assertEq(
            registry.getExtension(FOUNDER_NFT_KEY),
            address(founderNFTProxy),
            "FounderNFT should be registered with correct key"
        );

        // Test extension validation
        assertTrue(registry.isExtensionRegistered(PROJECT_FACTORY_KEY), "ProjectFactory should be registered");
        assertTrue(registry.isExtensionRegistered(FOUNDER_NFT_KEY), "FounderNFT should be registered");

        // Test that unregistered extensions return false
        assertFalse(registry.isExtensionRegistered(ORACLE_KEY), "Oracle should not be registered");

        // Test getAllExtensions function
        (bytes32[] memory keys, address[] memory addresses) = registry.getAllExtensions();
        assertTrue(keys.length > 0, "Should return extension keys");
        assertTrue(addresses.length > 0, "Should return extension addresses");
        assertEq(keys.length, addresses.length, "Keys and addresses arrays should be same length");
    }

    function testDynamicExtensionManagement() public {
        // Test registering a new extension dynamically
        address mockOracle = makeAddr("mockOracle");
        bytes32[] memory permissions = new bytes32[](1);
        permissions[0] = keccak256("PRICE_FEED_ACCESS");

        vm.prank(owner);
        registry.registerExtension(
            ORACLE_KEY,
            mockOracle,
            CATEGORY_ORACLE,
            "Mock Oracle",
            "1.0.0",
            "Provides price data for projects",
            permissions
        );

        assertTrue(registry.isExtensionRegistered(ORACLE_KEY), "Oracle should be registered");
        assertEq(registry.getExtension(ORACLE_KEY), mockOracle, "Oracle address should match");

        // Test extension info retrieval
        (,,,,, string memory name, string memory version, string memory description,) =
            registry.getExtensionInfo(ORACLE_KEY);

        assertEq(name, "Mock Oracle", "Extension name should match");
        assertEq(version, "1.0.0", "Extension version should match");
        assertEq(description, "Provides price data for projects", "Extension description should match");

        // Test removing an extension
        vm.prank(owner);
        registry.removeExtension(ORACLE_KEY);

        assertFalse(registry.isExtensionRegistered(ORACLE_KEY), "Oracle should be removed");
        assertEq(registry.getExtension(ORACLE_KEY), address(0), "Oracle address should be zero");
    }

    function testExtensionUpgrade() public {
        // Create a mock oracle and register it
        address mockOracleV1 = makeAddr("mockOracleV1");
        address mockOracleV2 = makeAddr("mockOracleV2");

        vm.prank(owner);
        registry.registerExtension(
            ORACLE_KEY,
            mockOracleV1,
            CATEGORY_ORACLE,
            "Mock Oracle",
            "1.0.0",
            "Provides price data for projects",
            new bytes32[](0)
        );

        // Upgrade to V2
        vm.prank(owner);
        registry.upgradeExtension(ORACLE_KEY, mockOracleV2, "2.0.0");

        assertEq(registry.getExtension(ORACLE_KEY), mockOracleV2, "Oracle should be upgraded to V2");

        (,,,,,, string memory version,,) = registry.getExtensionInfo(ORACLE_KEY);
        assertEq(version, "2.0.0", "Extension version should be updated");
    }

    function testExtensionDeactivation() public {
        // Register an extension
        address mockValidator = makeAddr("mockValidator");

        vm.prank(owner);
        registry.registerExtension(
            VALIDATOR_KEY,
            mockValidator,
            CATEGORY_VALIDATOR,
            "Mock Validator",
            "1.0.0",
            "Validates project milestones",
            new bytes32[](0)
        );

        assertTrue(registry.isExtensionRegistered(VALIDATOR_KEY), "Validator should be registered");

        // Deactivate extension
        vm.prank(owner);
        registry.deactivateExtension(VALIDATOR_KEY);

        assertFalse(registry.isExtensionRegistered(VALIDATOR_KEY), "Validator should be deactivated");
        assertTrue(registry.extensionExists(VALIDATOR_KEY), "Validator should still exist but be inactive");

        // Reactivate extension
        vm.prank(owner);
        registry.activateExtension(VALIDATOR_KEY);

        assertTrue(registry.isExtensionRegistered(VALIDATOR_KEY), "Validator should be reactivated");
    }

    function testProjectWithDynamicExtensions() public {
        // Create a project with enabled extensions
        vm.prank(creator);

        // Prepare extension configuration
        bytes32[] memory enabledExtensions = new bytes32[](2);
        enabledExtensions[0] = FOUNDER_NFT_KEY;
        enabledExtensions[1] = PROJECT_FACTORY_KEY;

        bytes[] memory extensionConfigs = new bytes[](2);
        extensionConfigs[0] = abi.encode("founder_nft_config");
        extensionConfigs[1] = abi.encode("factory_config");

        address[] memory teamMembers = new address[](0);

        projectAddress = registry.createProject(
            creator, "Dynamic Test Project", "Testing dynamic extension system", 10 ether, 30 days, false, teamMembers
        );

        project = Project(payable(projectAddress));

        // Verify project was created and registered
        assertTrue(registry.isProjectRegistered(projectAddress), "Project should be registered");

        // Test project extension management
        vm.prank(creator);
        project.enableExtension(FOUNDER_NFT_KEY, abi.encode("updated_config"));

        assertTrue(project.isExtensionEnabled(FOUNDER_NFT_KEY), "FounderNFT extension should be enabled");

        // Test extension configuration
        bytes memory config = project.getExtensionConfig(FOUNDER_NFT_KEY);
        assertEq(config, abi.encode("updated_config"), "Extension config should be updated");
    }

    function testEnhancedFeeDistributionWithDynamicSystem() public {
        // Step 1: Mint and stake FounderNFT
        vm.prank(founder1);
        founderNFT.mint{value: NFT_PRICE}();

        vm.prank(founder1);
        founderNFT.stakeToken(0);

        // Step 2: Create a project
        vm.prank(creator);
        address[] memory teamMembers = new address[](0);
        projectAddress = registry.createProject(
            creator,
            "Dynamic Fee Test Project",
            "Testing enhanced fee distribution with dynamic extensions",
            10 ether,
            30 days,
            false,
            teamMembers
        );

        project = Project(payable(projectAddress));

        // Step 3: Add milestones
        vm.startPrank(creator);
        project.addMilestone("Initial Development", "First phase", 3 ether, block.timestamp + 15 days, bytes32(0), "");
        project.addMilestone("MVP Release", "Second phase", 4 ether, block.timestamp + 25 days, bytes32(0), "");
        project.addMilestone("Final Product", "Final phase", 3 ether, block.timestamp + 30 days, bytes32(0), "");
        vm.stopPrank();

        // Step 4: Fund the project
        vm.prank(investor1);
        project.invest{value: 6 ether}();

        vm.prank(investor2);
        project.invest{value: 5 ether}();

        // Step 5: Complete funding period and update state
        vm.warp(block.timestamp + 31 days);
        project.updateProjectState();

        // Step 6: Complete first milestone
        vm.prank(creator);
        project.completeMilestone(0, "Development completed");

        // Check balances before release
        uint256 treasuryBalanceBefore = treasury.balance;
        uint256 founderNFTBalanceBefore = address(founderNFT).balance;

        // Step 7: Release milestone funds
        vm.prank(creator);
        project.releaseMilestoneFunds(0);

        // Calculate expected amounts
        uint256 milestoneAmount = 3 ether;
        uint256 platformFee = (milestoneAmount * 500) / 10000; // 5% fee
        uint256 founderShare = (platformFee * 5000) / 10000; // 50% of platform fee
        uint256 treasuryShare = platformFee - founderShare; // Remaining 50%

        console.log("Platform fee:", platformFee);
        console.log("Founder share (50%):", founderShare);
        console.log("Treasury share (50%):", treasuryShare);

        // Verify fee distribution
        assertEq(treasury.balance, treasuryBalanceBefore + treasuryShare, "Treasury should receive 50% of platform fee");
        assertGt(
            address(founderNFT).balance,
            founderNFTBalanceBefore,
            "FounderNFT should receive founder portion through relay"
        );
    }

    function testFactoryValidationWithDynamicSystem() public {
        // Test that registered factory works
        assertTrue(
            registry.isFactoryRegistered(address(factoryProxy)),
            "ProjectFactory should be recognized as registered factory"
        );

        // Test with unregistered factory
        address fakeFactory = makeAddr("fakeFactory");
        assertFalse(registry.isFactoryRegistered(fakeFactory), "Fake factory should not be recognized");

        // Test project initialization with unregistered factory
        Project projectImplementation = new Project();

        bytes32[] memory enabledExtensions = new bytes32[](0);
        bytes[] memory extensionConfigs = new bytes[](0);

        bytes memory initData = abi.encodeWithSelector(
            Project.initialize.selector,
            creator,
            "Test Project",
            "Description",
            1 ether,
            30 days,
            false,
            500,
            treasury,
            address(registry),
            new address[](0),
            enabledExtensions,
            extensionConfigs
        );

        // This should fail because fakeFactory is not registered
        vm.prank(fakeFactory);
        vm.expectRevert("Only registered factories can initialize projects");
        new ERC1967Proxy(address(projectImplementation), initData);
    }

    function testExtensionsByCategory() public {
        // Register extensions in different categories
        address mockNFTFactory = makeAddr("mockNFTFactory");
        address mockTokenFactory = makeAddr("mockTokenFactory");
        address mockGovernance = makeAddr("mockGovernance");

        vm.startPrank(owner);

        registry.registerExtension(
            NFT_FACTORY_KEY,
            mockNFTFactory,
            CATEGORY_FACTORY,
            "NFT Factory",
            "1.0.0",
            "Creates project NFTs",
            new bytes32[](0)
        );

        registry.registerExtension(
            TOKEN_FACTORY_KEY,
            mockTokenFactory,
            CATEGORY_FACTORY,
            "Token Factory",
            "1.0.0",
            "Creates project tokens",
            new bytes32[](0)
        );

        registry.registerExtension(
            keccak256("GOVERNANCE"),
            mockGovernance,
            CATEGORY_GOVERNANCE,
            "Governance Module",
            "1.0.0",
            "Handles project governance",
            new bytes32[](0)
        );

        vm.stopPrank();

        // Test getting extensions by category
        (bytes32[] memory factoryKeys, address[] memory factoryAddresses) =
            registry.getExtensionsByCategory(CATEGORY_FACTORY);

        assertTrue(factoryKeys.length >= 3, "Should have at least 3 factory extensions");

        // Verify NFT and Token factories are in the results
        bool foundNFTFactory = false;
        bool foundTokenFactory = false;
        bool foundProjectFactory = false;

        for (uint256 i = 0; i < factoryKeys.length; i++) {
            if (factoryKeys[i] == NFT_FACTORY_KEY) foundNFTFactory = true;
            if (factoryKeys[i] == TOKEN_FACTORY_KEY) foundTokenFactory = true;
            if (factoryKeys[i] == PROJECT_FACTORY_KEY) foundProjectFactory = true;
        }

        assertTrue(foundNFTFactory, "NFT Factory should be in factory category");
        assertTrue(foundTokenFactory, "Token Factory should be in factory category");
        assertTrue(foundProjectFactory, "Project Factory should be in factory category");
    }

    function testEmergencyFeeControlsWithDynamicSystem() public {
        // Create and fund a project
        vm.prank(creator);
        address[] memory teamMembers = new address[](0);
        projectAddress = registry.createProject(
            creator, "Emergency Test Project", "Testing emergency fee controls", 5 ether, 30 days, false, teamMembers
        );

        project = Project(payable(projectAddress));

        vm.prank(creator);
        project.addMilestone("Emergency Test", "Test milestone", 5 ether, block.timestamp + 15 days, bytes32(0), "");

        vm.prank(investor1);
        project.invest{value: 5 ether}();

        vm.warp(block.timestamp + 31 days);
        project.updateProjectState();

        // Emergency freeze fee distribution
        address emergencyRecipient = makeAddr("emergency");
        vm.prank(owner);
        registry.toggleEmergencyFreeze(true, emergencyRecipient);

        // Verify freeze status
        (bool frozen, address recipient) = registry.getEmergencyStatus();
        assertTrue(frozen, "Fee distribution should be frozen");
        assertEq(recipient, emergencyRecipient, "Emergency recipient should be set");

        // Try to release milestone funds - should fail due to freeze
        vm.prank(creator);
        project.completeMilestone(0, "Test completion");

        // This should fail because fee distribution is frozen
        vm.prank(creator);
        vm.expectRevert("Platform emergency mode active");
        project.releaseMilestoneFunds(0);

        // Unfreeze and try again
        vm.prank(owner);
        registry.toggleEmergencyFreeze(false, address(0));

        (bool frozenAfter,) = registry.getEmergencyStatus();
        assertFalse(frozenAfter, "Fee distribution should be unfrozen");

        // Now milestone release should work
        vm.prank(creator);
        project.releaseMilestoneFunds(0);
    }

    function testDynamicExtensionUtilities() public {
        // Test extension key generation utility
        bytes32 generatedKey = registry.generateExtensionKey("MY_CUSTOM_EXTENSION");
        bytes32 expectedKey = keccak256(abi.encodePacked("MY_CUSTOM_EXTENSION"));
        assertEq(generatedKey, expectedKey, "Generated key should match expected");

        // Test extension count
        uint256 initialCount = registry.getExtensionCount();
        assertGt(initialCount, 0, "Should have initial extensions");

        // Register new extension and check count increase
        address mockExtension = makeAddr("mockExtension");
        vm.prank(owner);
        registry.registerExtension(
            generatedKey,
            mockExtension,
            CATEGORY_UTILITY,
            "Custom Extension",
            "1.0.0",
            "Custom extension for testing",
            new bytes32[](0)
        );

        uint256 newCount = registry.getExtensionCount();
        assertEq(newCount, initialCount + 1, "Extension count should increase by 1");
    }

    function testProjectExtensionHelpers() public {
        // Create a project
        vm.prank(creator);
        address[] memory teamMembers = new address[](0);
        projectAddress = registry.createProject(
            creator, "Extension Helper Test", "Testing project extension helpers", 5 ether, 30 days, false, teamMembers
        );

        project = Project(payable(projectAddress));

        // Test extension key generation in project
        bytes32 testKey = project.generateExtensionKey("TEST_EXTENSION");
        assertEq(testKey, keccak256(abi.encodePacked("TEST_EXTENSION")), "Project should generate correct key");

        // Test extension existence check
        assertTrue(project.extensionExistsInRegistry(FOUNDER_NFT_KEY), "FounderNFT should exist in registry");
        assertFalse(
            project.extensionExistsInRegistry(keccak256("NONEXISTENT")), "Nonexistent extension should return false"
        );

        // Test getting extension from registry
        address founderNFTFromProject = project.getExtensionFromRegistry(FOUNDER_NFT_KEY);
        assertEq(founderNFTFromProject, address(founderNFTProxy), "Should return correct FounderNFT address");
    }
}
